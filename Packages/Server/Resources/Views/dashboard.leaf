<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>HomeBudget</title>
    <meta name="theme-color" content="#0f172a" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div
      id="app"
      data-user-name="#(userName)"
      data-user-email="#(userEmail)"
      data-user-initial="#(userInitial)"
      data-dev-mode="#(devMode)"
    ></div>

    <!-- The generated bundle imports the WASI shim by bare name. Mapping it to a vendored copy
         rather than a CDN keeps the app working offline, which is the point of the service worker. -->
    <script type="importmap">
      { "imports": { "@bjorn3/browser_wasi_shim": "/vendor/browser_wasi_shim.js" } }
    </script>
    <script type="module">
      import { init } from "/app/index.js";
      init().catch((error) => {
        document.getElementById("app").textContent = "Nie udało się uruchomić aplikacji: " + error;
        console.error(error);
      });
    </script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
      }
    </script>
  </body>
</html>

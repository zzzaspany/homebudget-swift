# Database — DATABASE_URL wins when set, otherwise the discrete variables are used.
# Real values belong in the secret manager, never here.
DATABASE_URL=postgres://homebudget:changeme@localhost:5432/homebudget
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=homebudget
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homebudget

# Serves a fixed local user instead of requiring reverse-proxy identity headers.
# Never enable this on a deployment reachable from outside the machine.
DEV_MODE=true

PORT=8000
INVOICE_STORAGE_PATH=./data/uploads

# Read-only credentials for machines: shortcuts, automations, scripts. Comma-separated
# `name:secret` pairs; the name is what the access log and /api/whoami report. Secrets must be at
# least 24 characters and belong in the secret manager, never here. Unset means no machine can
# call the API at all, which is the right default.
# API_TOKENS=shortcuts:generate-a-long-random-secret,n8n:another-long-random-secret

# Payment reminder e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=homebudget@localhost
SMTP_TLS=true
NOTIFICATION_EMAIL_TO=

# Host used by `make image-remote` to build a deployable image, as user@host.
BUILD_HOST=

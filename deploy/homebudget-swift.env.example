# Copy to ~/.config/containers/systemd/homebudget-swift.env and chmod 600.
#
# The database is the LXC at db-host (Proxmox container 120), not a container
# alongside this one — it is shared infrastructure with its own backup schedule.
DATABASE_URL=postgres://homebudget:CHANGEME@db-host:5432/homebudget?sslmode=disable

# Identity comes from Authelia through the proxy. Leave this false in production: with it on,
# anything that can reach the port is signed in.
DEV_MODE=false

# The Postfix relay handles TLS and credentials on the hop to the provider.
SMTP_HOST=smtp-relay
SMTP_PORT=25
SMTP_FROM=homebudget@example.lab
NOTIFICATION_EMAIL_TO=

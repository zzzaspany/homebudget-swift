# Copy to ~/.config/containers/systemd/homebudget-swift.env and chmod 600.
#
# The database is shared infrastructure with its own backups, not a container alongside this one.
#
# sslmode=require, not disable: the lab is one flat network, so without TLS every row crosses it in
# clear text. Note that postgres-kit enforces full certificate verification - chain of trust and
# hostname - on any TLS connection, whatever mode is asked for; there is no encrypt-without-
# verifying setting. So the server needs a certificate that is valid for the hostname used here and
# signed by a root this image trusts. The image carries OfficeLab Root CA 2026 for that reason.
DATABASE_URL=postgres://homebudget:CHANGEME@db-host:5432/homebudget?sslmode=require

# Identity comes from Authelia through the proxy. Leave this false in production: with it on,
# anything that can reach the port is signed in.
DEV_MODE=false

# A relay that accepts mail from the local network and handles TLS and credentials onward.
SMTP_HOST=smtp-relay
SMTP_PORT=25
SMTP_FROM=homebudget@example.lab
NOTIFICATION_EMAIL_TO=

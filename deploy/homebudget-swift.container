[Unit]
Description=HomeBudget (Swift rewrite, rootless Quadlet)
After=network-online.target

[Container]
ContainerName=homebudget-swift

Image=ghcr.io/zzzaspany/homebudget-swift:latest
AutoUpdate=registry

# Takes over the port used by the app it replaces, so the reverse-proxy entry and the
# authentication check in front of it need no change.
PublishPort=8000:8000

Volume=homebudget-swift-uploads:/app/data/uploads

EnvironmentFile=%h/.config/containers/systemd/homebudget-swift.env

[Service]
# Migrations run before the container starts. This belongs to [Service], not [Container] — the
# Quadlet generator rejects the whole unit if it appears above.
ExecStartPre=/usr/bin/podman run --rm --env-file %h/.config/containers/systemd/homebudget-swift.env ghcr.io/zzzaspany/homebudget-swift:latest migrate --yes
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

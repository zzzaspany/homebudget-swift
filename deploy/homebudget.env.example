# Copy to ~/.config/containers/systemd/homebudget.env
DATABASE_URL=postgres://homebudget:CHANGEME@homebudget-postgres:5432/homebudget?sslmode=disable

# Identity comes from Authelia via the reverse proxy. Leave DEV_MODE unset in production:
# with it on, anyone who can reach the port is signed in.
DEV_MODE=false

SMTP_HOST=smtp-relay
SMTP_PORT=25
SMTP_FROM=homebudget@example.lab
NOTIFICATION_EMAIL_TO=

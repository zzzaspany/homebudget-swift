# Copy to ~/.config/containers/systemd/infisical.env and chmod 600.
#
# These are the only credentials on the host. The identity reads one project — the one holding
# application secrets — and the deployment's own template narrows that further to the handful of
# values it actually names. The project boundary is what the server enforces: folders inside a
# project are organisational only, and granting access per folder needs a licence this instance
# does not have, which is why anything with a wider blast radius (certificate authority keys,
# infrastructure API tokens, host SSH keys) lives in a separate project this identity cannot read.
INFISICAL_HOST=https://vault.example.lab
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod

# Copy to ~/.config/containers/systemd/infisical.env and chmod 600.
#
# These are the only credentials on the host. The identity is scoped to read a single
# environment, so losing this file exposes far less than the secrets it fetches.
INFISICAL_HOST=https://vault.example.lab
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=homebudget-prd

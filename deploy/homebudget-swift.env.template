# Environment for the HomeBudget container, rendered by provision-secrets.sh.
#
# {{/folder/NAME}} is replaced with that secret's value from Infisical. Literal
# lines pass through unchanged, so non-secret settings stay visible in git
# rather than hiding in the vault.
#
# Placeholders are absolute paths: the folder is part of a secret's identity,
# and several services share /shared and /ntfy.

DATABASE_URL={{/homebudget/DATABASE_URL}}

# Outgoing mail goes through the lab's relay, which accepts private networks
# without authentication -- hence no SMTP_PASSWORD.
SMTP_HOST={{/shared/SMTP_RELAY_HOST}}
SMTP_PORT={{/shared/SMTP_RELAY_PORT}}
SMTP_FROM={{/homebudget/MAIL_FROM}}
SMTP_USER={{/homebudget/MAIL_USER}}
NOTIFICATION_EMAIL_TO={{/homebudget/MAIL_TO}}

# Push notifications publish as the scoped publisher account, not the admin one.
NTFY_URL={{/ntfy/BASE_URL}}
NTFY_TOPIC={{/ntfy/TOPIC}}
NTFY_USER={{/ntfy/PUBLISHER_USER}}
NTFY_PASSWORD={{/ntfy/PUBLISHER_PASSWORD}}

DEV_MODE=false

# Secrets for the HomeBudget container, rendered by provision-secrets.sh.
#
# {{/path/key}} is replaced with field <key> of the OpenBao KV secret at secret/<path>.
# Literal lines pass through unchanged.
#
# Only secrets and generic settings belong here. Deployment-specific settings (SMTP relay,
# sender and recipient addresses, ntfy server and topic) are not in this public repository:
# the unit reads them from a second file, ~/.config/containers/systemd/homebudget-swift.config.env,
# kept with the rest of the host's configuration. See docs/deployment.md for the variables.

DATABASE_URL={{/office-lab-v1/postgres/homebudget/database_url}}

# Push notifications publish as the scoped publisher account, not the admin one.
NTFY_USER={{/office-lab-v1/ntfy/labalerts/username}}
NTFY_PASSWORD={{/office-lab-v1/ntfy/labalerts/password}}

DEV_MODE=false

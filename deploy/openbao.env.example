# Copy to ~/.config/containers/systemd/openbao.env and chmod 600.
#
# These are the only credentials on the host. The AppRole's policy covers three paths — this
# deployment's own, plus the two it shares with other services — and the server refuses everything
# else with a 403. That was tested, not assumed: the role reads its three paths and is denied on the
# other services' paths on this same host, on the certificate authority keys, and on the
# infrastructure API token.
#
# A SecretID can be revoked by its accessor without disturbing the role, so losing this file is
# recoverable without re-issuing anything else.
BAO_ADDR=https://openbao.example.lab
BAO_ROLE_ID=
BAO_SECRET_ID=

[Unit]
Description=PostgreSQL for HomeBudget
After=network-online.target

[Container]
ContainerName=homebudget-postgres
Image=docker.io/library/postgres:17-alpine
Network=homebudget.network
# No PublishPort: the database is reachable only from the app on the internal network.
Volume=homebudget-pgdata:/var/lib/postgresql/data
EnvironmentFile=%h/.config/containers/systemd/homebudget-postgres.env
# The cluster must be UTF-8 with Polish collation, or sorting and comparison of
# Polish text silently misbehave — Debian's default install produced SQL_ASCII.
Environment=POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=pl_PL.UTF-8
HealthCmd=pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}
HealthInterval=10s
HealthRetries=5

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

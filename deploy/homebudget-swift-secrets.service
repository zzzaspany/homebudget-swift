[Unit]
Description=Fetch HomeBudget secrets from Infisical
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/provision-secrets.sh
# Without this the container starts against stale or missing secrets, which fails in ways that
# look like a database problem rather than a provisioning one.
TimeoutStartSec=60

[Install]
WantedBy=default.target
